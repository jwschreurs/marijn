# Alleen op de server gebruiken; nooit NEXT_PUBLIC_ ervoor zetten.
# DATABASE_URL wordt door de Neon-koppeling in Vercel ingesteld.
DATABASE_URL=

# Maak deze waarde met: npm run beheer:wachtwoord
# Plak de volledige scrypt-hash, niet het gewone wachtwoord.
ADMIN_PASSWORD_HASH=
# Microsoft 365-verzending; uitleg: docs/formulieren-mail.md
MS365_TENANT_ID=
MS365_CLIENT_ID=
MS365_CLIENT_SECRET=
MS365_SENDER=info@marijnmetaandacht.nl

# Spamcontrole; zie docs/spambescherming.md
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
